PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Enable only behind a trusted deployment proxy such as Railway.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, server-only, and used exclusively for account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Prisma runtime connection. Use a pooled URL for the API when available.
DATABASE_URL=
# Prisma CLI connection. Use the direct Postgres URL for introspection/migrations.
DIRECT_URL=
RATE_LIMIT_CATALOG=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_GENERATION=10
RATE_LIMIT_METRICS=30
RATE_LIMIT_DELETION=3
