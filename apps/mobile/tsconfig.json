{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["jest"],
    "paths": {
      "@/*": ["src/*"],
      "adaptfit-pose": ["modules/adaptfit-pose/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/adaptfit-pose/index.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
