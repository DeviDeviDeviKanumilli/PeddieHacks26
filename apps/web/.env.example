# Optional. When omitted locally, Vite proxies /api to http://localhost:3000.
VITE_API_URL=

# Set both values to enable live Supabase Auth. The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put a Supabase service-role key or another server secret in a VITE_ variable.
