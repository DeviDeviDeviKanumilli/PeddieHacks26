generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model users {
  id                         String                       @id @db.Uuid
  daily_progress             daily_progress[]
  exercise_session_summaries exercise_session_summaries[]
  exercise_sessions          exercise_sessions[]
  metric_batches             metric_batches[]
  movement_profiles          movement_profiles?
  profiles                   profiles?
  rep_metrics                rep_metrics[]
  session_events             session_events[]
  user_body_regions          user_body_regions[]
  user_capabilities          user_capabilities[]
  user_equipment             user_equipment[]
  user_goals                 user_goals[]
  user_settings              user_settings?
  workout_items              workout_items[]
  workout_sessions           workout_sessions[]
  workouts                   workouts[]

  @@schema("auth")
}

